# Resend — transactional email for the enquiry form.
# Copy to .env.local and fill in real values. Do not commit .env.local.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# "From" must be on a Resend-verified domain.
ENQUIRY_FROM="Sillage Égypte <enquiries@sillage-egypte.com>"
# Where enquiries are delivered.
ENQUIRY_TO=hello@sillage-egypte.com

# Admin (/admin) — edits the content/*.json files.
# Required: the password for /admin/login. Use a long, unique one.
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions (default: derived from the password).
ADMIN_SESSION_SECRET=
# Production: save edits as commits so they survive redeploys. A fine-grained
# GitHub token with "Contents: read and write" on this repository only.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=desertcanvasart-dotcom/Sillage-gypte
ADMIN_GITHUB_BRANCH=main
